<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="HerAlf - Servicios Legales a tu Alcance. Resolvemos tus trámites legales de forma rápida y confiable">
    <title>HerAlf - Servicios Legales a tu Alcance</title>
    <link rel="stylesheet" href="assets/styles/main.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@400;600&display=swap" rel="stylesheet">
    <!-- AWS SDK -->
    <script src="https://sdk.amazonaws.com/js/aws-sdk-2.1234.0.min.js"></script>
</head>
<body>
    <!-- Header -->
    <header>
        <div class="container">
            <div class="logo-container">
                <div class="logo">
                    <span class="logo-icon">⚖️</span>
                    <span class="logo-text">HerAlf</span>
                </div>
                <p class="tagline">Servicios Legales a la Mano</p>
            </div>
            <nav>
                <ul>
                    <li><a href="#inicio">Inicio</a></li>
                    <li><a href="#servicios">Servicios</a></li>
                    <li><a href="#como-funciona">Cómo Funciona</a></li>
                    <li><a href="#formulario" class="btn-nav">Solicitar Asesoría</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="inicio" class="hero">
        <div class="container">
            <div class="hero-content">
                <h1>Tu <span class="highlight">Derecho</span> es Nuestra Prioridad</h1>
                <p class="hero-description">En HerAlf simplificamos los trámites legales para que puedas resolver tus asuntos jurídicos de forma rápida, segura y accesible. Sin complicaciones, sin lenguaje técnico innecesario.</p>
                <div class="hero-stats">
                    <div class="stat">
                        <span class="stat-number">+500</span>
                        <span class="stat-text">Casos Resueltos</span>
                    </div>
                    <div class="stat">
                        <span class="stat-number">98%</span>
                        <span class="stat-text">Satisfacción</span>
                    </div>
                    <div class="stat">
                        <span class="stat-number">24h</span>
                        <span class="stat-text">Respuesta</span>
                    </div>
                </div>
                <a href="#formulario" class="btn-primary">Solicitar Asesoría Gratuita</a>
            </div>
            <div class="hero-image">
                <div class="floating-card">
                    <div class="card-icon">📝</div>
                    <h3>Derechos de Petición</h3>
                    <p>Resueltos en 72 horas</p>
                </div>
                <div class="floating-card">
                    <div class="card-icon">🛡️</div>
                    <h3>Acciones de Tutela</h3>
                    <p>Protección inmediata</p>
                </div>
                <div class="floating-card">
                    <div class="card-icon">⚔️</div>
                    <h3>Querellas</h3>
                    <p>Representación legal</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="servicios" class="services">
        <div class="container">
            <h2>Servicios Legales Especializados</h2>
            <p class="section-description">Te ayudamos con los trámites legales más comunes de forma eficiente y transparente</p>
            
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">📋</div>
                    <h3>Derechos de Petición</h3>
                    <p>Presentamos y seguimos tus derechos de petición ante cualquier entidad pública o privada.</p>
                    <ul>
                        <li>Respuesta garantizada por ley</li>
                        <li>Seguimiento constante</li>
                        <li>Formato profesional</li>
                    </ul>
                </div>
                
                <div class="service-card">
                    <div class="service-icon">🛡️</div>
                    <h3>Acciones de Tutela</h3>
                    <p>Protege tus derechos fundamentales cuando estos sean vulnerados por acción u omisión.</p>
                    <ul>
                        <li>Preparación completa</li>
                        <li>Presentación inmediata</li>
                        <li>Seguimiento judicial</li>
                    </ul>
                </div>
                
                <div class="service-card">
                    <div class="service-icon">⚔️</div>
                    <h3>Querellas y Denuncias</h3>
                    <p>Representación legal en procesos penales y administrativos de diversa índole.</p>
                    <ul>
                        <li>Asesoría especializada</li>
                        <li>Elaboración de documentos</li>
                        <li>Acompañamiento legal</li>
                    </ul>
                </div>
                
                <div class="service-card">
                    <div class="service-icon">📄</div>
                    <h3>Consultoría Legal</h3>
                    <p>Resuelve tus dudas jurídicas con nuestros abogados especializados en diversas áreas.</p>
                    <ul>
                        <li>Respuestas claras</li>
                        <li>Orientación precisa</li>
                        <li>Soluciones prácticas</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works -->
    <section id="como-funciona" class="how-it-works">
        <div class="container">
            <h2>¿Cómo Funciona?</h2>
            <p class="section-description">En 4 simples pasos puedes resolver tu situación legal</p>
            
            <div class="steps">
                <div class="step">
                    <div class="step-number">1</div>
                    <h3>Describe tu Caso</h3>
                    <p>Completa nuestro formulario con los detalles de tu situación legal.</p>
                </div>
                
                <div class="step">
                    <div class="step-number">2</div>
                    <h3>Análisis Especializado</h3>
                    <p>Nuestro equipo evaluará tu caso y te contactará en menos de 24 horas.</p>
                </div>
                
                <div class="step">
                    <div class="step-number">3</div>
                    <h3>Propuesta Personalizada</h3>
                    <p>Recibirás un plan de acción claro con costos y tiempos definidos.</p>
                </div>
                
                <div class="step">
                    <div class="step-number">4</div>
                    <h3>Solución y Seguimiento</h3>
                    <p>Nos encargamos de todo el proceso y te mantenemos informado.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Form -->
    <section id="formulario" class="contact-form-section">
        <div class="container">
            <div class="form-container">
                <div class="form-header">
                    <h2>Solicita tu Asesoría Legal</h2>
                    <p>Completa el formulario y un especialista se contactará contigo en menos de 24 horas</p>
                </div>
                
                <form id="legalForm" class="legal-form">
                    <div class="form-group">
                        <label for="nombre">Nombre Completo *</label>
                        <input type="text" id="nombre" name="nombre" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="email">Correo Electrónico *</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="telefono">Número de Contacto *</label>
                        <input type="tel" id="telefono" name="telefono" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="servicio">Tipo de Servicio Requerido *</label>
                        <select id="servicio" name="servicio" required>
                            <option value="">Selecciona una opción</option>
                            <option value="derecho-peticion">Derecho de Petición</option>
                            <option value="accion-tutela">Acción de Tutela</option>
                            <option value="querella">Querella o Denuncia</option>
                            <option value="consultoria">Consultoría Legal</option>
                            <option value="otro">Otro</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label for="descripcion">Describe tu Situación Legal *</label>
                        <textarea id="descripcion" name="descripcion" rows="5" placeholder="Describe brevemente tu caso o consulta legal..." required></textarea>
                    </div>
                    
                    <div class="form-group checkbox-group">
                        <input type="checkbox" id="privacidad" name="privacidad" required>
                        <label for="privacidad">Acepto la <a href="#" target="_blank">Política de Privacidad</a> y el tratamiento de mis datos *</label>
                    </div>
                    
                    <button type="submit" class="btn-primary btn-submit">Enviar Solicitud</button>
                </form>

                <p class="legal-disclaimer" style="font-size: 0.75rem; color: #333333; margin-top: 0.3rem; text-align: center; line-height: 1.3;">
                    HerAlf te conecta con abogados especializados. <br> Ellos evaluarán y guiarán tu caso.
                </p>
                
                <div id="formMessage" class="form-message"></div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    <div class="logo">
                        <span class="logo-icon">⚖️</span>
                        <span class="logo-text">HerAlf</span>
                    </div>
                    <p class="tagline">Servicios Legales a la Mano</p>
                    <p class="footer-description">Simplificamos el acceso a la justicia para todos.</p>
                </div>
                
                <div class="footer-links">
                    <div class="footer-column">
                        <h4>Servicios</h4>
                        <ul>
                            <li><a href="#servicios">Derechos de Petición</a></li>
                            <li><a href="#servicios">Acciones de Tutela</a></li>
                            <li><a href="#servicios">Querellas</a></li>
                            <li><a href="#servicios">Consultoría Legal</a></li>
                        </ul>
                    </div>
                    
                    <div class="footer-column">
                        <h4>Empresa</h4>
                        <ul>
                            <li><a href="#inicio">Sobre Nosotros</a></li>
                            <li><a href="#como-funciona">Cómo Funciona</a></li>
                            <li><a href="#formulario">Contacto</a></li>
                        </ul>
                    </div>
                    
                    <div class="footer-column">
                        <h4>Legal</h4>
                        <ul>
                            <li><a href="#" target="_blank">Términos y Condiciones</a></li>
                            <li><a href="#" target="_blank">Política de Privacidad</a></li>
                            <li><a href="#" target="_blank">Aviso Legal</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="footer-bottom">
                <p>&copy; <span id="currentYear"></span> HerAlf Servicios Legales. Todos los derechos reservados.</p>
                <div class="social-links">
                    <a href="#" aria-label="Facebook">f</a>
                    <a href="#" aria-label="Twitter">t</a>
                    <a href="#" aria-label="LinkedIn">in</a>
                </div>
            </div>
        </div>
    </footer>

    
    
    <script src="assets/js/form-handler.v4.js"></script>
    <script src="assets/js/app.js"></script>
</body>
</html>